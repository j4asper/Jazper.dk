@page "/"
@implements IAsyncDisposable

<PageTitle>Jazper</PageTitle>

<HeroSection/>

<section id="work" class="jz-section">
    <div class="jz-section-head">
        <h2 class="jz-glow"><span class="jz-mark">//</span>selected_work</h2>
        <a href="@GithubReposUrl" target="_blank" rel="noopener" class="jz-section-link">ls ~/repos &rarr; all</a>
    </div>

    <FlagshipWork/>

    <div class="jz-work-grid">
        @foreach (var project in GridProjects)
        {
            <WorkCard Project="project"/>
        }
    </div>
</section>

<StackSection/>

@if (Theme.Value.ShowSecuritySection)
{
    <SecuritySection/>
}

<section id="certs" class="jz-section">
    <div class="jz-section-head">
        <h2 class="jz-glow"><span class="jz-mark">//</span>certifications</h2>
        <a href="@Certifications.Value.CredlyProfileUrl" target="_blank" rel="noopener" class="jz-mono jz-section-link jz-section-link--sm">verify on credly &rarr;</a>
    </div>
    <p class="text-muted jz-section-intro">@Certifications.Value.Intro</p>

    <div class="jz-certs-grid">
        @foreach (var certification in Certifications.Value.CertificationList)
        {
            <CertificationCard Certification="certification"/>
        }
    </div>
</section>

@code {
    [Inject] public required IOptions<ProjectsOptions> Projects { get; set; }
    [Inject] public required IOptions<FlagshipOptions> Flagship { get; set; }
    [Inject] public required IOptions<CertificationsOptions> Certifications { get; set; }
    [Inject] public required IOptions<ThemeOptions> Theme { get; set; }
    [Inject] public required IOptions<HeroOptions> Hero { get; set; }
    [Inject] public required IJSRuntime JsRuntime { get; set; }

    private string GithubReposUrl => Hero.Value.GithubUrl.TrimEnd('/') + "?tab=repositories";

    private IEnumerable<Project> GridProjects =>
        Projects.Value.ProjectList.Where(p =>
            !p.Url.TrimEnd('/').Equals(Flagship.Value.PrimaryLinkUrl.TrimEnd('/'), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("jzHomeEffects.init", Hero.Value.TypedWords);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("jzHomeEffects.dispose");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }
}
