@inherits LayoutComponentBase

<div class="jz-shell" style="--color-accent:@Theme.Value.AccentColor">
    <div id="jz-orb" class="jz-orb"></div>

    <SiteHeader/>

    @Body

    <SiteFooter/>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#128473;</span>
</div>

@code {
    [Inject] public required IOptions<ThemeOptions> Theme { get; set; }
}
